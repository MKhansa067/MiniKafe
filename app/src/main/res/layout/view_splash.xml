<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Hero / Container Logo & Background (Tanpa pemotongan membulat) -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <!-- 1. Background Brewed Cup -->

        <!-- 2. Logo di atas background -->

        <ImageView
            android:id="@+id/ivBrewedCupBg"
            android:layout_width="550dp"
            android:layout_height="350dp"
            android:layout_gravity="center"
            android:layout_marginStart="42dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="Brewed Cup Background"
            android:scaleType="fitCenter"
            android:src="@drawable/brewed_cup" />

        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/minikafe_logo" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="MiniKafe"
        android:textColor="@color/secondary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Kopi dan Nyemil"
        android:textColor="@color/primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Get a taste of your wish"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Button "Start now" -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartNow"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/secondary"
        android:text="Start now"
        android:textAllCaps="false"
        android:textColor="@color/on_secondary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp" />

</LinearLayout>

